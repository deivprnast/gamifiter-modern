"features": [
{ "type": "Feature", "properties": { "info": "dest", "road": 0.0, "country": "Czechia", "city": "Prague", "code": "cz", "distance": 637.81497384194108, "country_cs": "Česká Republika", "city_cs": "Praha", "title": null, "content": "\"Praha je všeobecně považována za jedno z nejkrásnějších měst v Evropě. Historické centrum města s jedinečným panoramatem Pražského hradu, největšího hradního komplexu na světě, je památkovou rezervací UNESCO. Právě historické jádro města a mnohé památky přilákají ročně miliony turistů ze zemí celého světa. V roce 2017 navštívilo Prahu 8,5 milionu turistů, byla tak pátým nejnavštěvovanějším městem Evropy, po Londýně, Paříži, Istanbulu a Římu.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Praha", "start": true }, "geometry": { "type": "Point", "coordinates": [ 14.43775, 50.07555, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 1.0, "country": "Poland", "city": "Warsaw", "code": "pl", "distance": 575.73365097805822, "country_cs": "Polsko", "city_cs": "Varšava", "title": null, "content": "\"Varšava leží v historickém Mazovsku, od 15. století byla hlavním městem mazovského knížectví a v roce 1596 se namísto Krakova stala hlavním městem Polska. Významně do historie města zasáhla německá okupace za druhé světové války, kdy zde proběhlo povstání varšavského ghetta, varšavské povstání a byla zničena většina města.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Var%C5%A1ava", "start": false }, "geometry": { "type": "Point", "coordinates": [ 21.01222, 52.22968, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 2.0, "country": "Germany", "city": "Berlin", "code": "de", "distance": 658.23904890584402, "country_cs": "Německo", "city_cs": "Berlín", "title": null, "content": "\"Po druhé světové válce, město bylo z velké části zničeno (40 % obytné plochy).\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Berl%C3%ADn", "start": false }, "geometry": { "type": "Point", "coordinates": [ 13.40495, 52.52002, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 3.0, "country": "Netherlands", "city": "Amsterdam", "code": "nl", "distance": 209.82568521853094, "country_cs": "Nizozemsko", "city_cs": "Amsterdam", "title": null, "content": "\"Historie města Amsterdam sahá až k roku 1000, od kdy byla tato bažinatá oblast zvána Aemestelle. Kolem bažin byly kopány odvodňovací kanály (grachten). Nízká hladina vody byla v kanálech udržována pomocí přehrad (dijken). Ve 13. století byla jedna z přehrad vztyčena v ústí řeky Amstel, a tak vzniklo jméno Amsterdam.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Amsterdam", "start": false }, "geometry": { "type": "Point", "coordinates": [ 4.90418, 52.36757, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 4.0, "country": "Belgium", "city": "Brussels", "code": "be", "distance": 312.37647921616008, "country_cs": "Belgie", "city_cs": "Brusel", "title": null, "content": "Podle legendy založil osadu (město) kolem roku 580 sv. Guegerich (St. Géry). Jméno města je snad odvozeno od názvu Brucsella či Broekzelle, což znamená: ves v bažinách.Je sídlem NATO a některých institucí Evropské unie, a proto bývá neoficiálně označován jako „hlavní město Evropy“.", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Brusel", "start": false }, "geometry": { "type": "Point", "coordinates": [ 4.35715, 50.84765, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 5.0, "country": "France", "city": "Paris", "code": "fr", "distance": 1279.3124780927355, "country_cs": "Francie", "city_cs": "Paříž", "title": null, "content": "\"Paříž je ve Francii kulturním městem prvního řádu. Pro místní obyvatele i turisty nabízí nepřeberné množství kulturních institucí – přes 150 muzeí a 200 galerií, asi 100 divadel, přes 650 kin a více než 10 000 restaurací.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Pa%C5%99%C3%AD%C5%BE", "start": false }, "geometry": { "type": "Point", "coordinates": [ 2.35154, 48.85764, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 6.0, "country": "Spain", "city": "Madrid", "code": "es", "distance": 1964.1318736427211, "country_cs": "Španělsko", "city_cs": "Madrid", "title": null, "content": "Heslo města zní španělsky „Fui sobre agua edificada, mis muros de fuego son.“ – česky „Byl jsem na vodě zbudován, mé hradby z ohně jsou.“", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Madrid", "start": false }, "geometry": { "type": "Point", "coordinates": [ -3.70508, 40.41652, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 7.0, "country": "Italy", "city": "Rome", "code": "it", "distance": 1276.189390898224, "country_cs": "Itálie", "city_cs": "Řím", "title": null, "content": "\"Vzhledem k založení před více než 2 700 lety (podle římské tradice roku 753 př. n. l.) patří k nejstarším městům v Evropě. Po staletí byl Řím hlavním městem Římské říše, největší evropské velmoci starověku, a kolem roku 100 počet jeho obyvatel přesáhl 1,6 milionu. Město se stalo centrem křesťanství a dodnes je poutním místem.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/%C5%98%C3%Adm", "start": false }, "geometry": { "type": "Point", "coordinates": [ 12.49654, 41.90275, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 8.0, "country": "Greece", "city": "Athens", "code": "gr", "distance": 1179.3996291814603, "country_cs": "Řecko", "city_cs": "Athény", "title": null, "content": "\"Jsou jedním z nejstarších měst na světě. Starověké Athény byly mocným městským státem, kolébkou západní civilizace, filozofie a demokracie.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Ath%C3%A9ny", "start": false }, "geometry": { "type": "Point", "coordinates": [ 23.72754, 37.98381, 0.0 ] } },
{ "type": "Feature", "properties": { "info": "dest", "road": 9.0, "country": "Romania", "city": "Bucharest", "code": "ro", "distance": 1353.2426827189636, "country_cs": "Rumunsko", "city_cs": "Bukurešť", "title": null, "content": "\"O původu názvu Bukurešti existuje několik teorií. Legenda tvrdí, že město založil bájný pastevec Bucur, podle něhož se město jmenuje. V rumunštině existuje slovo bucurie, což znamená radost. Proto se také někdy Bukurešti říká město radosti.\"", "reference": "Wikipedia, 2022", "link": "https://cs.wikipedia.org/wiki/Bukure%C5%A1%C5%A5", "start": false }, "geometry": { "type": "Point", "coordinates": [ 26.10278, 44.42659, 0.0 ] } },
